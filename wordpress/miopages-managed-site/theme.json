{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "46rem", "wideSize": "72rem" },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "surface", "name": "Surface", "color": "#fffdfa" },
        { "slug": "ink", "name": "Ink", "color": "#211b2c" },
        { "slug": "brand", "name": "Brand", "color": "#45386c" },
        { "slug": "on-brand", "name": "On brand", "color": "#ffffff" },
        { "slug": "support", "name": "Supporting surface", "color": "#eee9f7" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "slug": "system", "name": "System sans", "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var:preset|color|surface", "text": "var:preset|color|ink" },
    "spacing": { "blockGap": "1.25rem", "padding": { "left": "clamp(1rem, 4vw, 3rem)", "right": "clamp(1rem, 4vw, 3rem)" } },
    "typography": { "fontFamily": "var:preset|font-family|system", "lineHeight": "1.65" },
    "elements": {
      "heading": { "typography": { "lineHeight": "1.15" } },
      "h1": { "typography": { "fontSize": "clamp(2rem, 5vw, 4rem)" } },
      "h2": { "typography": { "fontSize": "clamp(1.5rem, 3vw, 2.5rem)" } },
      "link": { "color": { "text": "var:preset|color|brand" }, "typography": { "textDecoration": "underline" } },
      "button": { "color": { "background": "var:preset|color|brand", "text": "var:preset|color|on-brand" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Site header", "area": "header" },
    { "name": "footer", "title": "Site footer", "area": "footer" }
  ]
}
