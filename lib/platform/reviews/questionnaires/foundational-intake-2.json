          "key": "problem",
          "label": "What is the biggest problem with your current Web presence?",
          "kind": "textarea",
          "required": true,
          "labels": [
            {
              "when": {
                "field": "project",
                "oneOf": [
                  "Build a new Web presence from scratch"
                ]
              },
              "label": "What is the biggest challenge in establishing your new Web presence?"
