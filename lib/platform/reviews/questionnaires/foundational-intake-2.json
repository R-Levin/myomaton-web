          "required": true
        },
        {
          "key": "website",
          "label": "Website URL",
          "kind": "url"
        },
        {
          "key": "publicProfile",
          "label": "Other public profile or listing (optional)",
          "kind": "url"
        }
      ]
    },
    {
      "number": 3,
      "title": "What do you most want your Web presence to accomplish?",
      "fields": [
        {
          "key": "goals",
          "label": "Choose up to 3",
          "kind": "multiple",
          "choices": [
            "Get more qualified leads",
            "Help the right people understand what we offer",
            "Improve search visibility",
            "Promote a specific service, product, location, or Campaign",
            "Replace an outdated or ineffective website",
            "Establish a professional presence for a new business or organization",
