{
  "questionnaireVersion": "foundational-intake/2",
  "groups": [
    {
      "number": 1,
      "title": "What are you looking to do?",
      "fields": [
        {
          "key": "project",
          "label": "What are you looking to do?",
          "kind": "single",
          "choices": [
            "Improve or replace an existing Web presence",
            "Build a new Web presence from scratch",
            "Create a focused Campaign/addition alongside an existing presence"
          ],
          "required": true
        }
      ]
    },
    {
      "number": 2,
      "title": "What business or organization should we review?",
