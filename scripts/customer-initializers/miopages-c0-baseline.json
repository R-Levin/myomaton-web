        "width": "wide",
        "divider": "none",
        "spacing": "compact",
        "surface": "default",
        "alignment": "left",
        "composition": "editorial-row"
      }
    },
    {
      "id": "a0afbe15-927b-46f6-bb2b-474523124934",
      "name": "Primary Call to Action",
      "type": "cta",
      "status": "active",
      "content": {
        "text": "Follow the builds, experiments, failures, fixes, and occasional moments when the robot actually does what we hoped it would.",
        "heading": "See what happens next.",
        "actionId": "ec47c6b5-e75d-4dd7-a59a-dac14a8737d3"
      },
      "page_id": "fd7bdc57-c9b7-4274-b871-43cf2e9b09ee",
      "variant": "default",
      "version": 3,
