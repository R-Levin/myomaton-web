    {
      "id": "c1949ff0-f02f-4474-90e3-53ad7e7e74af",
      "name": "Core principles",
      "type": "collection",
      "status": "active",
      "content": {
        "items": [
          {
            "id": "principle-001",
            "text": "Practical robotics becomes much more interesting when ordinary hardware can participate.",
            "heading": "Affordable"
          },
          {
            "id": "principle-002",
            "text": "The system should be possible to inspect, explain, modify, and repair.",
            "heading": "Understandable"
          },
          {
            "id": "principle-003",
            "text": "Useful machines should not become disposable because one component or service disappears.",
            "heading": "Repairable"
          },
          {
            "id": "principle-004",
            "text": "Core behavior and safety should remain close to the robot rather than depending unnecessarily on remote services.",
            "heading": "Local-first"
          },
          {
            "id": "principle-005",
            "text": "Cloud and AI services can add capability, but basic ownership and usefulness should not depend on continuing payments or Internet access.",
            "heading": "No mandatory cloud or subscription"
          }
        ],
        "heading": "Core principles",
        "itemSource": "inline"
      },
