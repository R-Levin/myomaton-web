          "content": {
            "status": "reviewed-inline",
            "fields": {
              "contractVersion": 1,
              "kind": "responsibilities",
              "heading": "You know the business. We handle the web work.",
              "parties": [
                {
                  "id": "customer",
                  "label": "Your part"
                },
                {
                  "id": "miopages",
                  "label": "MioPages' part"
                }
              ],
              "rows": [
                {
                  "id": "understand",
                  "label": "Understand the business",
                  "cells": [
                    {
                      "partyId": "customer",
                      "text": "Supply accurate information, priorities and existing assets."
                    },
                    {
                      "partyId": "miopages",
                      "text": "Organize the offer, audience and information into a clear presence."
                    }
                  ]
                },
                {
                  "id": "approve",
                  "label": "Review and approve",
                  "cells": [
                    {
                      "partyId": "customer",
                      "text": "Approve business claims, presentation and material changes."
                    },
                    {
                      "partyId": "miopages",
                      "text": "Prepare a professional result you can review without specifying layouts or technical instructions."
                    }
                  ]
                },
                {
                  "id": "continue",
                  "label": "Keep the relationship useful",
                  "cells": [
                    {
                      "partyId": "customer",
                      "text": "Share business changes and provide necessary account access for agreed work."
                    },
                    {
                      "partyId": "miopages",
                      "text": "Coordinate agreed setup and carry your business knowledge into ongoing care."
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "id": "fb79e5af-9199-440b-95c6-d13467c94742",
          "order": 50,
          "type": "intro",
          "variant": "default",
          "presentation": {
            "region": "connected",
            "surface": "light"
          },
          "content": {
            "status": "reviewed-inline",
            "fields": {
              "heading": "Keep useful connections. Keep the scope clear.",
              "text": "Booking, contact, publishing, and other external services can be connected where a supported approach exists. Hosting, domains, and email can be coordinated where needed; they support the service rather than define it.\n\nMioPages is a good fit if you want a clear professional presence and continuing care. Bespoke applications, unlimited redesign, full CRM replacement, and broad social-media management are outside the service."
            }
          }
        },
        {
          "id": "1d156d4e-27d1-4f2b-89e3-17ac2721f21c",
          "order": 60,
          "type": "intro",
          "variant": "default",
          "presentation": {
            "region": "connected",
            "surface": "light"
          },
          "content": {
            "status": "requires-canonical-projection",
            "bindingRole": "knowledge",
            "contextHeading": "Your business stays yours"
          }
        },
        {
          "id": "e09e1f2f-96bb-4e44-8d9b-324dbae2a386",
          "order": 70,
          "type": "cta",
          "variant": "default",
          "presentation": {
            "surface": "tonal",
            "region": "closing"
          },
          "content": {
            "status": "reviewed-inline",
            "fields": {
              "heading": "Find the right scope before you commit",
              "text": "Start with the free Review. Understand the priorities, check the fit, and decide whether Standard or Expanded Launch makes sense.\n\nPreview only · MioPages is not open for service or Review requests. This page describes the service model; no information can be submitted here.",
              "actionId": "ba6ee5af-ebce-4529-8072-dd0a1ecadc6f"
            }
          }
        }
      ]
