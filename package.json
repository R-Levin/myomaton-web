{
  "name": "myomaton-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "bootstrap:myomaton": "tsx --env-file=.env.local scripts/bootstrap-myomaton.ts",
    "update:myomaton-home-v1": "tsx --env-file=.env.local scripts/update-myomaton-home-v1.ts",
    "update:myomaton-secondary-pages-v1": "tsx --env-file=.env.local scripts/update-myomaton-secondary-pages-v1.ts",
    "update:myomaton-visual-direction-v1": "tsx --env-file=.env.local scripts/update-myomaton-visual-direction-v1.ts",
    "update:myomaton-visual-direction-v2": "tsx --env-file=.env.local scripts/update-myomaton-visual-direction-v2.ts",
    "db:bootstrap-photo": "tsx --env-file=.env.local scripts/bootstrap-myomaton-photo.ts",
    "assets:import": "tsx --env-file=.env.local scripts/import-managed-assets.ts",
    "test": "tsx --test tests/*.test.tsx",
    "test:postgres": "tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@puckeditor/core": "^0.23.0",
    "dompurify": "3.4.16",
    "drizzle-orm": "^0.45.3",
    "jsdom": "30.1.1",
    "next": "16.3.5",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
